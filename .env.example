# Copia este archivo como ".env" en la raiz del proyecto y llena los valores reales.
# El archivo ".env" NO se sube al repositorio (ver .gitignore).

# Cadena de conexion a MongoDB (Atlas o local)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/locaciones

# Puerto en el que corre el backend (Express)
PORT=4000

# Secreto usado para firmar los tokens JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=coloca_aqui_un_secreto_largo_y_aleatorio

# Tiempo de expiracion de los tokens JWT (ej: 1d, 12h, 30m)
JWT_EXPIRES_IN=1d

# URL base que usa el frontend (Vite) para llamar al backend
VITE_API_URL=http://localhost:4000/api

# Opcional: origen permitido por CORS en el backend.
# Si se deja vacio/comentado, el backend acepta cualquier http://localhost:<puerto>.
# CORS_ORIGIN=http://localhost:3000
